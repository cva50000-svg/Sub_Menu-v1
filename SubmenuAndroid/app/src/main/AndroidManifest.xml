<?xml version="1.0" encoding="utf-8"?>
<!-- Korenovy element AndroidManifest.xml definujuci balicek, opravnenia a komponenty aplikacie. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Opravnenie na zistenie vsetkych nainstalovanych aplikacii v systeme (relevantne od Android 11 / API 30). -->
    <!-- tools:ignore potlaca varovanie lint kontroly o obmedzeniach pouzitia QUERY_ALL_PACKAGES. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Hlavny kontajner aplikacie a jej globalnych vlastnosti. -->
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_server_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_server_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubmenuAndroid">
        <!-- Hlavna aktivita aplikacie; android:exported="true" povoluje spustenie zvonku (napr. launcherom). -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Intent filter oznacuje MainActivity ako vstupny bod launcher aplikacie. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
